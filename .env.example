# LiveKit Cloud project settings; enable Inference and SIP for this project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Stored LiveKit outbound trunk backed by your telephone provider.
SIP_OUTBOUND_TRUNK_ID=
# One purchased/verified E.164 number on that trunk, reused for every call.
CALLER_NUMBER=
# Separate STT -> text LLM -> TTS stages, accessed through LiveKit Inference.
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
MAX_CALL_SECONDS=180
ARTIFACTS_DIR=artifacts
